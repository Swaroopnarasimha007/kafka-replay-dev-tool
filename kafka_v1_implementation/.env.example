# Copy to .env and replace both passwords. Never commit .env.
LAB_USER=lab
LAB_PASSWORD=replace-with-a-random-password-at-least-12-characters
LAB_DB_PASSWORD=replace-with-a-different-random-password
# HTTP listener is container port 80; the browser uses host port 8088.
SITE_ADDRESS=http://localhost
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
# Cloud example: SITE_ADDRESS=replay.example.com, both BIND=0.0.0.0,
# HTTP_PORT=80, HTTPS_PORT=443. Point DNS at the server first.
